// The relay of pine's web client. `npm run dev` serves it locally. A pull request that touches the
// web client, and every push to next and main that does, gets a version of its own under a preview
// alias (pr-<number>, next, main: .github/workflows/web-preview.yml);
// the Worker's live version is changed only by hand (`npx wrangler deploy` in web/relay).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pine-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  // No live address on workers.dev: only the preview addresses of uploaded versions
  // (pr-<number>-, next- and main-pine-relay.<account>.workers.dev), which a workflow posts.
  "workers_dev": false,
  "preview_urls": true,
  // The web client's build (`npm run build` in web/), served by the same Worker: every request
  // goes through it first, which adds the headers of src/site.ts.
  "assets": { "directory": "../dist", "binding": "ASSETS", "run_worker_first": true },
  // No logs of the bytes carried: the relay writes none, and Workers Logs stay off.
  "observability": { "enabled": false },
  "ratelimits": [
    {
      // Connections per client IP: 20 a minute.
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
