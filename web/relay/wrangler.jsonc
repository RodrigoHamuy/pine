// The relay of pine's web client. `npm run dev` serves it locally. A pull request that touches the
// web client, and every push to next and main that does, gets a version of its own under a preview
// alias (pr-<number>, next, main: .github/workflows/web-preview.yml);
// the Worker's live version is changed only by hand (`npx wrangler deploy` in web/relay).
//
// Two configurations: this default one, for an owner's own deployment, with the SSH relay on and
// the meeting service beside it; and `official` (`npx wrangler deploy --env official`), the
// project's one service, with the relay off and an address on workers.dev.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pine-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  // No live address on workers.dev: only the preview addresses of uploaded versions
  // (pr-<number>-, next- and main-pine-relay.<account>.workers.dev), which a workflow posts.
  "workers_dev": false,
  "preview_urls": true,
  // The web client's build (`npm run build` in web/), served by the same Worker: every request
  // goes through it first, which adds the headers of src/site.ts.
  "assets": { "directory": "../dist", "binding": "ASSETS", "run_worker_first": true },
  // No logs of the bytes carried or of a meeting: the Worker writes none, and Workers Logs stay off.
  "observability": { "enabled": false },
  "ratelimits": [
    {
      // Connections per client IP: 20 a minute, for the relay and the meeting routes alike.
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  // The meeting service: one object per machine id, holding that meeting's hibernating sockets
  // and no storage (src/meet-object.ts).
  "durable_objects": { "bindings": [{ "name": "MEET", "class_name": "Meeting" }] },
  // The free plan has Durable Objects backed by SQLite only; the class uses none of its storage.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Meeting"] }],
  "vars": {
    // "on" serves the SSH relay at /ssh, for machines added as user@host.
    "RELAY": "on",
    // The servers that help a browser and a Mac connect directly, which both read from /meet/config.
    "ICE": [{ "urls": "stun:stun.cloudflare.com:3478" }]
  },
  "env": {
    // The project's official service: the web client and the meeting service, and no public SSH
    // proxy. Bindings and variables are not inherited by an environment, so each is written again.
    "official": {
      "name": "pine",
      // Its fixed address: pine.<account>.workers.dev.
      "workers_dev": true,
      // A Worker that holds a Durable Object gets no version addresses.
      "preview_urls": false,
      "assets": { "directory": "../dist", "binding": "ASSETS", "run_worker_first": true },
      "observability": { "enabled": false },
      "ratelimits": [
        {
          "name": "LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 20, "period": 60 }
        }
      ],
      "durable_objects": { "bindings": [{ "name": "MEET", "class_name": "Meeting" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Meeting"] }],
      "vars": {
        "RELAY": "off",
        "ICE": [{ "urls": "stun:stun.cloudflare.com:3478" }]
      }
    }
  }
}
