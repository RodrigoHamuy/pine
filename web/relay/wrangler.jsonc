// The relay of pine's web client, in three configurations:
//
// - The default one (no --env): the SSH relay and the web client, no meeting service. It is what
//   `.github/workflows/web-preview.yml` uploads as versions under a preview alias (pr-<number>,
//   next, main), and what `npx wrangler deploy` deploys by hand. It declares no Durable Object on
//   purpose: a version that adds one cannot be uploaded, and a Worker that holds one gets no
//   version addresses, which is all a preview is.
// - `official` (`npx wrangler deploy --env official`): the project's one service. The web client
//   and the meeting service, the relay off, at pine.<account>.workers.dev.
// - `full` (`npx wrangler deploy --env full`): an owner's own deployment that wants both, the
//   meeting service and the relay. `npx wrangler dev --env full` serves that locally.
//
// The Worker's live versions are changed only by hand. Bindings and variables are not inherited
// by an environment, so each one writes its own.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pine-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  // No live address on workers.dev: only the preview addresses of uploaded versions
  // (pr-<number>-, next- and main-pine-relay.<account>.workers.dev), which a workflow posts.
  "workers_dev": false,
  "preview_urls": true,
  // The web client's build (`npm run build` in web/), served by the same Worker: every request
  // goes through it first, which adds the headers of src/site.ts.
  "assets": { "directory": "../dist", "binding": "ASSETS", "run_worker_first": true },
  // No logs of the bytes carried or of a meeting: the Worker writes none, and Workers Logs stay off.
  "observability": { "enabled": false },
  "ratelimits": [
    {
      // Connections per client IP: 20 a minute, for the relay and the meeting routes alike.
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "vars": {
    // "on" serves the SSH relay at /ssh, for machines added as user@host; anything else refuses it.
    "RELAY": "on"
  },
  "env": {
    // The project's official service: the web client and the meeting service, and no public SSH proxy.
    "official": {
      "name": "pine",
      // Its fixed address: pine.<account>.workers.dev.
      "workers_dev": true,
      // A Worker that holds a Durable Object gets no version addresses.
      "preview_urls": false,
      "assets": { "directory": "../dist", "binding": "ASSETS", "run_worker_first": true },
      "observability": { "enabled": false },
      "ratelimits": [
        {
          "name": "LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 20, "period": 60 }
        }
      ],
      // The meeting service: one object per machine id, holding that meeting's hibernating
      // sockets and no storage (src/meet-object.ts).
      "durable_objects": { "bindings": [{ "name": "MEET", "class_name": "Meeting" }] },
      // The free plan has Durable Objects backed by SQLite only; the class uses none of its storage.
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Meeting"] }],
      "vars": {
        "RELAY": "off",
        // The servers that help a browser and a Mac connect directly, which both read from /meet/config.
        "ICE": [{ "urls": "stun:stun.cloudflare.com:3478" }]
      }
    },
    // A deployment of one's own with the meeting service and the relay side by side.
    "full": {
      "name": "pine-full",
      "workers_dev": false,
      // A Worker that holds a Durable Object gets no version addresses.
      "preview_urls": false,
      "assets": { "directory": "../dist", "binding": "ASSETS", "run_worker_first": true },
      "observability": { "enabled": false },
      "ratelimits": [
        {
          "name": "LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 20, "period": 60 }
        }
      ],
      "durable_objects": { "bindings": [{ "name": "MEET", "class_name": "Meeting" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Meeting"] }],
      "vars": {
        "RELAY": "on",
        "ICE": [{ "urls": "stun:stun.cloudflare.com:3478" }]
      }
    }
  }
}
